# Dominio principal. Las apps quedan en: DOMINIO, kioscos.DOMINIO, riders.DOMINIO y dev.DOMINIO.
DOMINIO=freedeli.com.ar
# Para los avisos de los certificados HTTPS (Let's Encrypt).
EMAIL_ADMIN=admin@freedeli.com.ar

# Base de datos. Generar con: openssl rand -base64 24
POSTGRES_PASSWORD=
# Firma de las sesiones. Generar con: openssl rand -base64 48
JWT_SECRET=

# Cuenta del dueño (FreeDeli Dev). Se crea al primer arranque.
DEV_EMAIL=
DEV_CLAVE=

# Reglas de negocio (opcionales).
COMISION_PORCENTAJE=10
TARIFA_BASE=1000
TARIFA_POR_KM=400
ALIAS_FREEDELI=freedeli.pagos
# Pedidos solo de 00 a 08 hs. true permite pedir a cualquier hora: solo para pruebas.
HORARIO_LIBRE=false
