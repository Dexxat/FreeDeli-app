// FreeDeli · modelo de datos. Refleja los modelos de projects/shared/src/lib/models.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  USUARIO
  KIOSCO
  RIDER
  DEV
}

/// Usuarios quedan aprobados al registrarse; kioscos y riders esperan la aprobación de Dev.
enum EstadoCuenta {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum Zona {
  SAN_MIGUEL
  MUNIZ
  BELLA_VISTA
}

enum EstadoPedido {
  ESPERANDO
  ACEPTADO
  RETIRADO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum FasePedido {
  STOCK
  AJUSTE
  TRANSFERENCIA
  RIDER
  APROBACION
}

enum EstadoPago {
  PENDIENTE
  TRANSFERIDO
  LIBERADO
}

enum TipoDocumento {
  SEGURO
  LICENCIA
}

enum TipoMovimientoSaldo {
  CARGA
  COMISION
  /// FreeDeli le devuelve al kiosco el saldo a favor que usó el cliente.
  PREMIO
}

model Cuenta {
  id        String       @id @default(uuid())
  email     String       @unique
  /// scrypt: "sal:hash" en hexadecimal.
  clave     String
  rol       Rol
  estado    EstadoCuenta
  creadaEn  DateTime     @default(now())
  usuario   Usuario?
  kiosco    Kiosco?
  rider     Rider?
}

model Usuario {
  id          String   @id @default(uuid())
  cuentaId    String   @unique
  cuenta      Cuenta   @relation(fields: [cuentaId], references: [id])
  /// Nombre y apellido.
  nombre      String
  dni         String?
  telefono    String
  direccion   String
  notas       String?
  zona        Zona
  lat         Float
  lng         Float
  /// FREEDELI RUSH: estrellas hacia el próximo premio (0 a 4).
  estrellas   Int      @default(0)
  /// Saldo a favor en pesos: se descuenta solo del próximo pedido.
  saldoFavor  Int      @default(0)
  pedidos     Pedido[]
}

model Kiosco {
  id                String            @id @default(uuid())
  cuentaId          String?           @unique
  cuenta            Cuenta?           @relation(fields: [cuentaId], references: [id])
  nombre            String
  zona              Zona
  direccion         String
  lat               Float
  lng               Float
  pausado           Boolean           @default(false)
  /// Saldo prepago en pesos. De acá se descuentan las comisiones.
  saldo             Int               @default(0)
  tiempoEstimadoMin Int               @default(25)
  aliasCobro        String
  productos         Producto[]
  pedidos           Pedido[]
  movimientosSaldo  MovimientoSaldo[]
}

model Producto {
  id         String  @id @default(uuid())
  kioscoId   String
  kiosco     Kiosco  @relation(fields: [kioscoId], references: [id])
  nombre     String
  precio     Int
  disponible Boolean @default(true)

  @@index([kioscoId])
}

model Rider {
  id             String   @id @default(uuid())
  cuentaId       String   @unique
  cuenta         Cuenta   @relation(fields: [cuentaId], references: [id])
  nombre         String
  telefono       String
  dni            String
  vehiculoModelo String
  patente        String
  aliasCbu       String
  notificaciones Boolean  @default(true)
  sonidos8bit    Boolean  @default(true)
  disponible     Boolean  @default(false)
  zonas          Zona[]
  pausado        Boolean  @default(false)
  riderDesde     DateTime @default(now())
  pedidos        Pedido[]
  ofertas        Oferta[]
  sesionesOnline SesionOnline[]
  documentos     DocumentoRider[]
}

model Pedido {
  id               String        @id @default(uuid())
  numero           Int           @unique @default(autoincrement())
  zona             Zona
  kioscoId         String
  kiosco           Kiosco        @relation(fields: [kioscoId], references: [id])
  usuarioId        String
  usuario          Usuario       @relation(fields: [usuarioId], references: [id])
  destinoNombre    String
  destinoDireccion String
  destinoNotas     String?
  distanciaKm      Float
  costoEnvio       Int
  propina          Int           @default(0)
  gananciaRider    Int
  pago             EstadoPago    @default(PENDIENTE)
  aliasKiosco      String
  comisionFreeDeli Int
  /// Saldo a favor del cliente usado en el pedido (premio de FREEDELI RUSH). Lo pone FreeDeli.
  descuentoPremio  Int           @default(0)
  pin              String
  estado           EstadoPedido  @default(ESPERANDO)
  fase             FasePedido?   @default(STOCK)
  ridersRechazados String[]      @default([])
  retiroKiosco     DateTime?
  retiroRider      DateTime?
  riderId          String?
  rider            Rider?        @relation(fields: [riderId], references: [id])
  creadoEn         DateTime      @default(now())
  aceptadoEn       DateTime?
  enCaminoEn       DateTime?
  entregadoEn      DateTime?
  /// El cliente ya ganó la estrella de FREEDELI RUSH con este pedido.
  estrellaGanada   Boolean       @default(false)
  items            ItemPedido[]
  ofertas          Oferta[]

  @@index([kioscoId, estado])
  @@index([usuarioId, estado])
  @@index([riderId, estado])
  @@index([creadoEn])
}

model ItemPedido {
  id             String  @id @default(uuid())
  pedidoId       String
  pedido         Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId     String
  nombre         String
  cantidad       Int
  precioUnitario Int
  /// Quitado por el kiosco por falta de stock.
  quitado        Boolean @default(false)

  @@index([pedidoId])
}

/// Pedido ofrecido a un rider, con vencimiento.
model Oferta {
  id       String   @id @default(uuid())
  pedidoId String
  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  riderId  String
  rider    Rider    @relation(fields: [riderId], references: [id])
  expiraEn DateTime
  creadaEn DateTime @default(now())

  @@unique([pedidoId, riderId])
}

model MovimientoSaldo {
  id              String              @id @default(uuid())
  kioscoId        String
  kiosco          Kiosco              @relation(fields: [kioscoId], references: [id])
  fecha           DateTime            @default(now())
  tipo            TipoMovimientoSaldo
  monto           Int
  referencia      String
  saldoResultante Int

  @@index([kioscoId, fecha])
}

/// Tramo en que el rider estuvo ON. Sirve para las horas online de Ganancias.
model SesionOnline {
  id      String    @id @default(uuid())
  riderId String
  rider   Rider     @relation(fields: [riderId], references: [id])
  desde   DateTime  @default(now())
  hasta   DateTime?

  @@index([riderId, desde])
}

/// Foto del seguro o de la licencia del rider. Se cargan en el alta.
model DocumentoRider {
  id            String        @id @default(uuid())
  riderId       String
  rider         Rider         @relation(fields: [riderId], references: [id], onDelete: Cascade)
  tipo          TipoDocumento
  mime          String
  datos         Bytes
  actualizadoEn DateTime      @updatedAt

  @@unique([riderId, tipo])
}
