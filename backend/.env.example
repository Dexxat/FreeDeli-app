# Postgres. En desarrollo lo levanta `npm run db` (Postgres embebido, puerto 5433).
DATABASE_URL="postgresql://freedeli:freedeli@localhost:5433/freedeli"
# Secreto para firmar los tokens de sesión. Cambiarlo en producción.
JWT_SECRET="cambiar-este-secreto"
# Cuenta del dueño (FreeDeli Dev). Se crea al iniciar si no existe.
DEV_EMAIL="dev@freedeli.local"
DEV_CLAVE="cambiar-esta-clave"
PORT=3000

# true para poder pedir a cualquier hora (desarrollo). En producción: false, solo de 00 a 08 hs.
HORARIO_LIBRE=true

# Mail para recuperar la contraseña. Sin SMTP_HOST, el link queda en la consola de la API.
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PUERTO=587
# SMTP_USUARIO=
# SMTP_CLAVE=
# SMTP_DESDE="FreeDeli <no-responder@freedeli.com.ar>"
